# Password for the pages.
#
# Leave this UNSET and the site is public. That is the opposite of the event app,
# which fails closed: this one is a public analysis site, so a fresh deploy should
# come up working. Set it and every page sits behind the gate.
#
# Rotating it invalidates every unlock cookie already handed out, because the
# password is part of what gets signed.
APP_PASSWORD=

# Signs the unlock cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# If unset, a random key is generated at boot: the app still works, but unlock
# cookies stop being valid after every restart.
SECRET_KEY=

# ── Data ──
# The aggregates the pages read. Written by build_sample.py today, and by the
# Supabase loader later.
# SUMMARY_JSON=
# DATA_DIR=
# Where build_sample.py finds the raw tracking files.
# TRACKING_DIR=

# ── Supabase (not used yet) ──
# Read from the environment so the names are settled, but nothing connects until
# data_source.py is switched over.
# SUPABASE_URL=
# SUPABASE_KEY=

# Local dev only; Railway injects PORT itself.
# PORT=5003
