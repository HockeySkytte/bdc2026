# Copy to .env for local development, or set the same names in Railway's
# variables. Nothing here is needed to deploy except DATABASE_URL.

# ── Access ──────────────────────────────────────────────────────────────────
# Leave this UNSET and the site is public. That is the opposite of the event
# app, which fails closed: this one is a public analysis site, so a fresh deploy
# should come up working. Set it and every page sits behind the gate.
#
# Rotating it invalidates every unlock cookie already handed out, because the
# password is part of what gets signed.
APP_PASSWORD=

# Signs the unlock cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# If unset, a random key is generated at boot: the app still works, but unlock
# cookies stop being valid after every restart.
SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Supabase. Use the session pooler on 5432, not the transaction pooler on 6543:
# a multi-statement read will not survive transaction mode. The app rewrites the
# port if you paste the 6543 string anyway.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ── Local only ──────────────────────────────────────────────────────────────
# Railway injects PORT itself.
# PORT=5003
